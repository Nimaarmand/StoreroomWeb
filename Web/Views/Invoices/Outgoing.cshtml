@model List<GoodsIssueDto>
@{
    ViewData["Title"] = "فاکتور خروجی تأییدشده";
    var keyword = (string?)ViewData["Keyword"];
    var days = (int)(ViewData["Days"] ?? 30);
    var total = Model.Sum(i => (i.UnitSellingPrice ?? 0) * i.Quantity);
    var totalQty = Model.Sum(i => i.Quantity);
}

<div class="page-head">
    <div>
        <h1 class="page-title">
            <span class="page-title-icon"><i class="bi bi-box-arrow-up-right"></i></span>
            فاکتور خروجی تأییدشده
            <span class="page-count num">@PersianDate.Digits(Model.Count.ToString())</span>
        </h1>
        <div class="page-sub">
            <i class="bi bi-info-circle"></i>
            فقط اسنادی نمایش داده می‌شوند که تأیید شده‌اند و موجودی را جابه‌جا کرده‌اند.
        </div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="GoodsIssues" asp-action="Index">
        <i class="bi bi-arrow-return-right"></i> بازگشت به حواله‌ها
    </a>
</div>

<form method="get" class="app-toolbar">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label" for="keyword">جست‌وجو</label>
            <div class="app-search">
                <i class="bi bi-search"></i>
                <input class="form-control" id="keyword" name="keyword" value="@keyword"
                       placeholder="شماره فاکتور، کالا یا مشتری" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="days">بازه زمانی</label>
            <select class="form-select" id="days" name="days">
                <option value="7" selected="@(days == 7)">۷ روز اخیر</option>
                <option value="30" selected="@(days == 30)">۳۰ روز اخیر</option>
                <option value="90" selected="@(days == 90)">۹۰ روز اخیر</option>
                <option value="365" selected="@(days == 365)">یک سال اخیر</option>
                <option value="0" selected="@(days == 0)">همه</option>
            </select>
        </div>
        <div class="col-6 col-md-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> اعمال</button>
            @if (!string.IsNullOrWhiteSpace(keyword) || days != 30)
            {
                <a class="btn btn-outline-secondary" asp-action="Outgoing">بازنشانی</a>
            }
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="app-empty">
            <div class="app-empty-icon"><i class="bi bi-file-earmark-text"></i></div>
            <div class="fw-semibold text-dark">فاکتور خروجی تأییدشده‌ای در این بازه وجود ندارد</div>
            <div class="small">بازه زمانی را تغییر دهید یا حواله‌های در انتظار تأیید را بررسی کنید.</div>
        </div>
    </div>
}
else
{
    <div class="card app-table-card">
        <div class="app-table-wrap">
            <table class="table table-hover align-middle">
                <colgroup>
                    <col style="width:14%" /><col style="width:15%" /><col style="width:14%" /><col style="width:12%" />
                    <col style="width:9%" /><col style="width:14%" /><col style="width:12%" /><col style="width:10%" />
                </colgroup>
                <thead>
                    <tr>
                        <th>شماره فاکتور</th>
                        <th>کالا</th>
                        <th>مشتری</th>
                        <th>نوع</th>
                        <th class="text-center">تعداد</th>
                        <th class="text-center">مبلغ کل</th>
                        <th>تاریخ</th>
                        <th class="text-center">چاپ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td class="fw-semibold num" style="text-align:right">@(string.IsNullOrWhiteSpace(i.InvoiceNumber) ? "—" : i.InvoiceNumber)</td>
                            <td>@i.ProductName</td>
                            <td>@(string.IsNullOrWhiteSpace(i.CustomerName) ? "—" : i.CustomerName)</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(i.TypeText) ? "—" : i.TypeText)</td>
                            <td class="text-center">
                                <span class="num fw-semibold">@PersianDate.Digits(i.Quantity.ToString())</span>
                                <span class="small text-muted-2">@i.Unit</span>
                            </td>
                            <td class="text-center num">@PersianNumberConverter.ToPersianDigits(((i.UnitSellingPrice ?? 0) * i.Quantity).ToString("N0"))</td>
                            <td class="small text-muted-2">@PersianDate.ToPersianDate(i.IssueDate)</td>
                            <td class="text-center col-actions">
                                <a class="btn btn-outline-primary btn-sm" asp-action="PrintOutgoing" asp-route-id="@i.IssueId">
                                    <i class="bi bi-printer"></i> چاپ
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="app-table-foot">
            <span><i class="bi bi-box-arrow-up"></i> جمع @PersianDate.Digits(totalQty.ToString()) عدد کالا</span>
            <span>
                جمع کل فاکتورها:
                <strong class="num text-dark">@PersianNumberConverter.ToPersianDigits(total.ToString("N0"))</strong>
            </span>
        </div>
    </div>
}
