@model List<GoodsReceiptDto>
@{
    ViewData["Title"] = "رسیدها";
    var keyword = ViewData["Keyword"] as string;
    var canApprove = User.IsInRole("Admin") || User.IsInRole("Manager");
}

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-info py-2">@msg</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <input type="text" name="keyword" value="@keyword" class="form-control"
               placeholder="جستجو در شماره فاکتور، کالا، تامین‌کننده..." />
    </div>
    <div class="col-12 col-md-auto">
        <button class="btn btn-primary" type="submit">جستجو</button>
        <a class="btn btn-outline-secondary" asp-action="Index">همه</a>
    </div>
</form>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-truck"></i> فهرست رسیدها</span>
        <span class="badge text-bg-secondary num">@PersianDate.Digits(Model.Count.ToString())</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>شماره فاکتور</th>
                    <th>کالا</th>
                    <th>تامین‌کننده</th>
                    <th>انبار</th>
                    <th class="text-center">تعداد</th>
                    <th class="text-center">قیمت واحد</th>
                    <th class="text-center">مبلغ کل</th>
                    <th>تاریخ رسید</th>
                    <th class="text-center">وضعیت</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-secondary py-4">
                            رسیدی یافت نشد.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.InvoiceNumber</td>
                            <td>@r.ProductName</td>
                            <td>@r.SupplierName</td>
                            <td class="text-secondary">@(string.IsNullOrWhiteSpace(r.WarehouseName) ? "—" : r.WarehouseName)</td>
                            <td class="text-center">
                                <span class="num">@PersianDate.Digits(r.Quantity.ToString())</span>
                                <span class="small text-secondary">@r.Unit</span>
                            </td>
                            <td class="text-center num">@PersianDate.Digits(r.UnitPrice.ToString("N0"))</td>
                            <td class="text-center num fw-semibold">@PersianDate.Digits(r.NetPrice.ToString("N0"))</td>
                            <td class="num">@PersianDate.ToPersianDate(r.ReceiptDate)</td>
                            <td class="text-center">
                                <span class="badge @Web.Models.StatusBadge.Css(0)">
                                    @(string.IsNullOrWhiteSpace(r.StatusText) ? Web.Models.StatusBadge.Text(0) : r.StatusText)
                                </span>
                            </td>
                            <td class="text-center text-nowrap">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@r.ReceiptId">جزئیات</a>
                                @if (canApprove)
                                {
                                    <form asp-action="Approve" asp-route-id="@r.ReceiptId" method="post"
                                          class="d-inline">
                                        <button class="btn btn-sm btn-success" type="submit"
                                                title="تأیید و به‌روزرسانی موجودی">تأیید</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
