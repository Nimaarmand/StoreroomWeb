@model List<Product>
@{
    ViewData["Title"] = "کالاها";
    var keyword = (string?)ViewData["Keyword"];
    var lowStockOnly = (bool?)ViewData["LowStockOnly"] ?? false;
    var categoryNames = ViewBag.CategoryNames as Dictionary<int, string>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">کالاها <span class="text-secondary fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-primary" asp-action="Create">کالای جدید</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label" for="keyword">جست‌وجو</label>
        <input class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="نام کالا" />
    </div>
    <div class="col-12 col-md-3 form-check ms-2 mb-2">
        <input class="form-check-input" type="checkbox" id="lowStockOnly" name="lowStockOnly" value="true" @(lowStockOnly ? "checked" : "") />
        <label class="form-check-label" for="lowStockOnly">فقط زیر حداقل موجودی</label>
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(keyword) || lowStockOnly)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">حذف فیلتر</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">کالایی برای نمایش وجود ندارد.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>دسته‌بندی</th>
                        <th>واحد</th>
                        <th>بارکد</th>
                        <th class="text-center">موجودی</th>
                        <th class="text-center">حداقل</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    var isLow = p.MinStockLevel.HasValue && p.Number.HasValue && p.Number < p.MinStockLevel;
                    <tr class="@(isLow ? "table-warning" : "")">
                        <td>
                            <span class="fw-semibold">@p.Name</span>
                            @if (!string.IsNullOrWhiteSpace(p.Barcode) || !string.IsNullOrWhiteSpace(p.Description))
                            {
                                <div class="small text-secondary">
                                    @if (!string.IsNullOrWhiteSpace(p.Barcode))
                                    {
                                        <span>بارکد: @p.Barcode</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(p.Barcode) ? "" : " - ")@p.Description</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>@(p.CategoryId.HasValue && categoryNames != null && categoryNames.TryGetValue(p.CategoryId.Value, out var cn) ? cn : "-")</td>
                        <td>@p.BaseUnit</td>
                        <td class="font-monospace small">@(string.IsNullOrWhiteSpace(p.Barcode) ? "-" : p.Barcode)</td>
                        <td class="text-center @(isLow ? "fw-bold text-danger" : "")">@PersianNumberConverter.ToPersianDigits(p.Number ?? 0)</td>
                        <td class="text-center">@PersianNumberConverter.ToPersianDigits(p.MinStockLevel ?? 0)</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge text-bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">غیرفعال</span>
                            }
                            @if (isLow)
                            {
                                <span class="badge text-bg-danger">زیر حداقل</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@p.ProductId">ویرایش</a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@p.ProductId" class="d-inline">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        @(p.IsActive ? "غیرفعال" : "فعال")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
