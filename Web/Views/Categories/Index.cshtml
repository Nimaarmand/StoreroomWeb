@model List<Category>
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    var keyword = (string?)ViewData["Keyword"];
    var parentNames = ViewBag.ParentNames as Dictionary<int, string>;
    var childCounts = ViewBag.ChildCounts as Dictionary<int, int>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">دسته‌بندی‌ها <span class="text-secondary fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-primary" asp-action="Create">دسته‌بندی جدید</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label" for="keyword">جست‌وجو</label>
        <input class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="نام دسته‌بندی" />
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">حذف فیلتر</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">دسته‌بندی‌ای برای نمایش وجود ندارد.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>دسته والد</th>
                        <th class="text-center">تعداد زیر‌دسته</th>
                        <th>توضیحات</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    var hasChildren = childCounts != null && childCounts.TryGetValue(c.CategoryId, out var cc) && cc > 0;
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@(c.ParentId.HasValue && parentNames != null && parentNames.TryGetValue(c.ParentId.Value, out var pn) ? pn : "-")</td>
                        <td class="text-center">@(hasChildren ? childCounts![c.CategoryId] : "-")</td>
                        <td class="small text-secondary">@(string.IsNullOrWhiteSpace(c.Description) ? "-" : c.Description)</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge text-bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">غیرفعال</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@c.CategoryId">ویرایش</a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@c.CategoryId" class="d-inline">
                                    <button class="btn btn-outline-secondary" type="submit">@(c.IsActive ? "غیرفعال" : "فعال")</button>
                                </form>
                                @await Html.PartialAsync("_DeleteButton", new Web.Models.DeleteButtonModel(
                                    c.CategoryId, $"دسته‌بندی «{c.Name}» حذف شود؟"))
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
