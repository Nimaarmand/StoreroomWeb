@model List<Supplier>
@{
    ViewData["Title"] = "تأمین‌کنندگان";
    var keyword = (string?)ViewData["Keyword"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">تأمین‌کنندگان <span class="text-secondary fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-primary" asp-action="Create">تأمین‌کننده جدید</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label" for="keyword">جست‌وجو</label>
        <input class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="نام تأمین‌کننده" />
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">حذف فیلتر</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">تأمین‌کننده‌ای برای نمایش وجود ندارد.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>تلفن</th>
                        <th>کد اقتصادی</th>
                        <th>نشانی</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.Name</td>
                        <td class="font-monospace small" dir="ltr" style="text-align:right">@(string.IsNullOrWhiteSpace(s.Phone) ? "-" : s.Phone)</td>
                        <td class="font-monospace small">@(string.IsNullOrWhiteSpace(s.EconomicCode) ? "-" : s.EconomicCode)</td>
                        <td class="small text-secondary">@(string.IsNullOrWhiteSpace(s.Address) ? "-" : s.Address)</td>
                        <td class="text-center">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@s.SupplierId">ویرایش</a>
                            @await Html.PartialAsync("_DeleteButton", new Web.Models.DeleteButtonModel(
                                s.SupplierId, $"تأمین‌کننده «{s.Name}» حذف شود؟"))
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
