@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = user != null && await UserManager.IsInRoleAsync(user, "Admin");
    var isManager = user != null && (await UserManager.IsInRoleAsync(user, "Manager") || isAdmin);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - مدیریت انبار</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">

    <nav class="navbar navbar-expand-lg bg-primary shadow-sm" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="fs-5">📦 مدیریت انبار</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="نمایش منو">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">داشبورد</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">اطلاعات پایه</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">کالاها</a></li>
                            <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">دسته‌بندی‌ها</a></li>
                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index">مشتریان</a></li>
                            <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index">تأمین‌کنندگان</a></li>
                            <li><a class="dropdown-item" asp-controller="Warehouses" asp-action="Index">انبارها</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="GoodsReceipts" asp-action="Index">رسیدها</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="GoodsIssues" asp-action="Index">حواله‌ها</a>
                    </li>
                    @* مدیریت کاربران فقط برای مدیر سامانه؛ کنترلر هم AdminOnly است. *@
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">کاربران</a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @if (user != null)
                    {
                        <span class="navbar-text text-white-50">
                            @user.FullName
                            @if (isAdmin)
                            {
                                <span class="badge text-bg-warning ms-1">مدیر</span>
                            }
                            else if (isManager)
                            {
                                <span class="badge text-bg-info ms-1">سرپرست</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary ms-1">کاربر</span>
                            }
                        </span>
                        @* خروج باید POST باشد و توکن ضدجعل داشته باشد؛
                           پیوند <a> درخواست GET می‌فرستد و اکشن فقط POST می‌پذیرد. *@
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">خروج</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">ورود</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 px-lg-4">
        @* پیام‌های نتیجه عملیات؛ بدون این بخش کاربر پس از ریدایرکت
           هیچ بازخوردی از موفقیت یا خطای اعتبارسنجی نمی‌بیند. *@
        @if (TempData["Message"] is string message && !string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
            </div>
        }
        @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top mt-4 py-3 bg-white">
        <div class="container-fluid px-lg-4 text-center text-secondary small">
            مدیریت انبار — @(DateTime.Now.Year)
        </div>
    </footer>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
