@model WarehouseFormModel
@{
    var isEdit = ViewContext.RouteData.Values.ContainsKey("id");
    ViewData["Title"] = isEdit ? "ویرایش انبار" : "انبار جدید";
}

<div class="mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">بازگشت به فهرست</a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")">
    @if (isEdit)
    {
        <input type="hidden" name="id" value="@Model.WarehouseId" />
    }
    <input type="hidden" asp-for="WarehouseId" />

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">اطلاعات انبار</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="Name"></label>
                    <input class="form-control" asp-for="Name" autofocus />
                    <span class="text-danger small" asp-validation-for="Name"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" asp-for="Location"></label>
                    <input class="form-control" asp-for="Location" />
                    <span class="text-danger small" asp-validation-for="Location"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label" asp-for="Min"></label>
                    <input class="form-control" asp-for="Min" />
                    <span class="text-danger small" asp-validation-for="Min"></span>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label" asp-for="Max"></label>
                    <input class="form-control" asp-for="Max" />
                    <span class="text-danger small" asp-validation-for="Max"></span>
                </div>

                @if (isEdit)
                {
                    <div class="col-12 col-md-3">
                        <label class="form-label">موجودی فعلی</label>
                        <input class="form-control" value="ثبت‌شده در سیستم" disabled />
                        <div class="form-text">موجودی فقط با رسید و حواله تغییر می‌کند.</div>
                    </div>
                }

                <div class="col-12 col-md-3">
                    <label class="form-label" asp-for="Status"></label>
                    <select class="form-select" asp-for="Status">
                        <option value="فعال">فعال</option>
                        <option value="غیرفعال">غیرفعال</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex gap-2">
            <button class="btn btn-primary" type="submit">ذخیره</button>
            <a class="btn btn-outline-secondary" asp-action="Index">انصراف</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
