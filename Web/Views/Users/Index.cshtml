@model List<UserListItem>
@using Domain.Entity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "کاربران";
    var keyword = (string?)ViewData["Keyword"];
    var currentUserId = UserManager.GetUserId(User);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">کاربران <span class="text-secondary fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-primary" asp-action="Create">کاربر جدید</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label" for="keyword">جست‌وجو</label>
        <input class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="نام کاربری یا نام و نام خانوادگی" />
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">حذف فیلتر</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">کاربری برای نمایش وجود ندارد.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>نام و نام خانوادگی</th>
                    <th>نام کاربری</th>
                    <th>تماس</th>
                    <th>نقش‌ها</th>
                    <th>وضعیت</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isSelf = u.Id == currentUserId;
                    <tr>
                        <td class="fw-semibold">
                            @u.FullName
                            @if (isSelf)
                            {
                                <span class="badge text-bg-info">شما</span>
                            }
                        </td>
                        <td dir="ltr" class="text-end">@u.UserName</td>
                        <td class="small">
                            <div>@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)</div>
                            <div class="text-secondary" dir="ltr">@(string.IsNullOrWhiteSpace(u.Email) ? "" : u.Email)</div>
                        </td>
                        <td>
                            @foreach (var role in u.Roles)
                            {
                                <span class="badge text-bg-secondary">@role</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge text-bg-success">فعال</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">غیرفعال</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">ویرایش</a>
                                @* حساب خودتان را نمی‌شود غیرفعال یا حذف کرد؛ کنترلر هم این را بررسی می‌کند. *@
                                @if (!isSelf)
                                {
                                    <form method="post" asp-action="ToggleActive" asp-route-id="@u.Id" class="d-inline">
                                        <button class="btn btn-outline-secondary" type="submit">
                                            @(u.IsActive ? "غیرفعال" : "فعال")
                                        </button>
                                    </form>
                                    <form method="post" asp-action="Delete" asp-route-id="@u.Id" class="d-inline"
                                          onsubmit="return confirm('کاربر «@u.UserName» حذف شود؟');">
                                        <button class="btn btn-outline-danger" type="submit">حذف</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
