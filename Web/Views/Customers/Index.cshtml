@model List<Customer>
@{
    ViewData["Title"] = "مشتریان";
    var keyword = (string?)ViewData["Keyword"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">مشتریان <span class="text-secondary fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-primary" asp-action="Create">مشتری جدید</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label" for="keyword">جست‌وجو</label>
        <input class="form-control" id="keyword" name="keyword" value="@keyword" placeholder="نام مشتری" />
    </div>
    <div class="col-12 col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">اعمال</button>
        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">حذف فیلتر</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">مشتری‌ای برای نمایش وجود ندارد.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>نام بازار</th>
                        <th>تلفن</th>
                        <th>نشانی</th>
                        <th class="text-center">تاریخ ایجاد</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(c.MarketName) ? "-" : c.MarketName)</td>
                        <td class="font-monospace small" dir="ltr" style="text-align:right">@(string.IsNullOrWhiteSpace(c.Phone) ? "-" : c.Phone)</td>
                        <td class="small text-secondary">@(string.IsNullOrWhiteSpace(c.Address) ? "-" : c.Address)</td>
                        <td class="text-center small">@PersianDate.ToPersianDate(c.Creationdate)</td>
                        <td class="text-center">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@c.CustomerId">ویرایش</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
